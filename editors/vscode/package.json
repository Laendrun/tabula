{
  "name": "tabula-syntax",
  "displayName": "Tabula Game Files",
  "description": "Highlighting and live checks for Tabula .game files (board and card game rules).",
  "version": "0.15.0",
  "publisher": "Laendrun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laendrun/tabula",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/Laendrun/tabula/tree/main/editors/vscode#readme",
  "bugs": {
    "url": "https://github.com/Laendrun/tabula/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "tabula",
    "board games",
    "card games",
    "rules",
    "game rules"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "tabula",
        "aliases": [
          "Tabula",
          "tabula"
        ],
        "extensions": [
          ".game",
          ".sheet"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "tabula",
        "path": "./snippets/tabula.json"
      }
    ],
    "grammars": [
      {
        "language": "tabula",
        "scopeName": "source.tabula",
        "path": "./syntaxes/tabula.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter.tabula": "yaml"
        }
      }
    ],
    "commands": [
      {
        "command": "tabula.checkVault",
        "title": "Check the whole vault",
        "category": "Tabula"
      },
      {
        "command": "tabula.checkFile",
        "title": "Check this game",
        "category": "Tabula"
      },
      {
        "command": "tabula.openPreview",
        "title": "Open preview to the side",
        "category": "Tabula",
        "icon": "$(open-preview)"
      },
      {
        "command": "tabula.formatFile",
        "title": "Format this file",
        "category": "Tabula"
      },
      {
        "command": "tabula.formatVault",
        "title": "Format every file in the vault",
        "category": "Tabula"
      }
    ],
    "configuration": {
      "title": "Tabula",
      "properties": {
        "tabula.path": {
          "type": "string",
          "default": "tabula",
          "markdownDescription": "The `tabula` command. Leave as is if `tabula` works in a terminal; otherwise the full path to `tabula.exe`, or `python` together with `#tabula.extraArgs#`."
        },
        "tabula.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Arguments put before `check`, e.g. `[\"${workspaceFolder}/cli/tabula\"]` with `#tabula.path#` set to `python`."
        },
        "tabula.vault": {
          "type": "string",
          "default": "",
          "markdownDescription": "The vault folder. Empty: found from the file (the folder with `vault.yaml`, or the folder around the game's folder). `${workspaceFolder}` works."
        },
        "tabula.run": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "default": "onType",
          "enumDescriptions": [
            "Check while typing (after a short pause)",
            "Check only when the file is saved"
          ],
          "description": "When to check the file."
        },
        "tabula.delay": {
          "type": "number",
          "default": 500,
          "description": "Pause after typing before checking, in milliseconds."
        },
        "tabula.requireDefinitions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Every component must also have a glossary definition (like `tabula check -d`)."
        },
        "tabula.spellCheck": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Underline the words the dictionary doesn't know, in the game's language (like `tabula check --spell`; needs tabula 0.12 with `spylls`). Correct words go in `words.txt` in the vault, or `words:` in the frontmatter. Also turned on by `check: {spelling: true}` in `vault.yaml`."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "tabula.openPreview",
          "when": "editorLangId == tabula",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tabula.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == tabula"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0",
    "@vscode/vsce": "3.6.0"
  }
}
