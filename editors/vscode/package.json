{
  "name": "tabula-syntax",
  "displayName": "Tabula Game Files",
  "description": "Highlighting and live checks for Tabula .game files (board and card game rules).",
  "version": "0.27.1",
  "publisher": "Laendrun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laendrun/tabula",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/Laendrun/tabula/tree/main/editors/vscode#readme",
  "bugs": {
    "url": "https://github.com/Laendrun/tabula/issues"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "tabula",
    "board games",
    "card games",
    "rules",
    "game rules"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "tabula",
        "aliases": [
          "Tabula",
          "tabula"
        ],
        "extensions": [
          ".game",
          ".sheet"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "tabula",
        "path": "./snippets/tabula.json"
      }
    ],
    "grammars": [
      {
        "language": "tabula",
        "scopeName": "source.tabula",
        "path": "./syntaxes/tabula.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter.tabula": "yaml"
        }
      }
    ],
    "commands": [
      {
        "command": "tabula.checkVault",
        "title": "Check the whole vault",
        "category": "Tabula",
        "icon": "$(check-all)"
      },
      {
        "command": "tabula.checkFile",
        "title": "Check this game",
        "category": "Tabula"
      },
      {
        "command": "tabula.openPreview",
        "title": "Open preview to the side",
        "category": "Tabula",
        "icon": "$(open-preview)"
      },
      {
        "command": "tabula.formatFile",
        "title": "Format this file",
        "category": "Tabula"
      },
      {
        "command": "tabula.formatVault",
        "title": "Format every file in the vault",
        "category": "Tabula"
      },
      {
        "command": "tabula.refreshPanel",
        "title": "Refresh",
        "category": "Tabula",
        "icon": "$(refresh)"
      },
      {
        "command": "tabula.buildSite",
        "title": "Write the site",
        "category": "Tabula",
        "icon": "$(globe)"
      },
      {
        "command": "tabula.buildBook",
        "title": "Write the book (EPUB)",
        "category": "Tabula",
        "icon": "$(book)"
      },
      {
        "command": "tabula.printSheet",
        "title": "Print the score sheet",
        "category": "Tabula",
        "icon": "$(table)"
      },
      {
        "command": "tabula.previewGame",
        "title": "Open preview",
        "category": "Tabula",
        "icon": "$(open-preview)"
      },
      {
        "command": "tabula.addWish",
        "title": "Add to the wishlist",
        "category": "Tabula",
        "icon": "$(add)"
      },
      {
        "command": "tabula.restartServer",
        "title": "Restart the language server",
        "category": "Tabula"
      }
    ],
    "configuration": {
      "title": "Tabula",
      "properties": {
        "tabula.path": {
          "type": "string",
          "default": "tabula",
          "markdownDescription": "The `tabula` command. Leave as is if `tabula` works in a terminal; otherwise the full path to `tabula.exe`, or `python` together with `#tabula.extraArgs#`. Only in your user settings: a folder's `.vscode/settings.json` can't change the command that runs (it could run anything).",
          "scope": "machine"
        },
        "tabula.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Arguments put before `check`, e.g. `[\"${workspaceFolder}/cli/tabula\"]` with `#tabula.path#` set to `python`. Only in your user settings: a folder's `.vscode/settings.json` can't change the command that runs (it could run anything).",
          "scope": "machine"
        },
        "tabula.vault": {
          "type": "string",
          "default": "",
          "markdownDescription": "The vault folder. Empty: found from the file (the folder with `vault.yaml`, or the folder around the game's folder). `${workspaceFolder}` works."
        },
        "tabula.delay": {
          "type": "number",
          "default": 500,
          "description": "Pause after typing before checking, in milliseconds.",
          "markdownDescription": "Milliseconds after you stop typing before the preview updates."
        },
        "tabula.requireDefinitions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Every component must also have a glossary definition (like `tabula check -d`)."
        },
        "tabula.previewFollowsCursor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "The preview scrolls to the part of the rules the cursor is in. Double-click in the preview to move the cursor there."
        },
        "tabula.spellCheck": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Underline the words the dictionary doesn't know, in the game's language (like `tabula check --spell`; needs tabula 0.12 with `spylls`). Correct words go in `words.txt` in the vault, or `words:` in the frontmatter. Also turned on by `check: {spelling: true}` in `vault.yaml`."
        },
        "tabula.siteFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where *Tabula: Write the site* writes the site (default: a `site` folder in the vault). Relative to the vault."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "tabula.openPreview",
          "when": "editorLangId == tabula",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "tabula.checkVault",
          "when": "view == tabula.games",
          "group": "navigation@1"
        },
        {
          "command": "tabula.buildSite",
          "when": "view == tabula.games",
          "group": "navigation@2"
        },
        {
          "command": "tabula.buildBook",
          "when": "view == tabula.games",
          "group": "navigation@3"
        },
        {
          "command": "tabula.refreshPanel",
          "when": "view == tabula.games",
          "group": "navigation@4"
        },
        {
          "command": "tabula.addWish",
          "when": "view == tabula.wishlist",
          "group": "navigation@1"
        },
        {
          "command": "tabula.refreshPanel",
          "when": "view == tabula.wishlist",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tabula.previewGame",
          "when": "view == tabula.games && viewItem =~ /^game/",
          "group": "inline@1"
        },
        {
          "command": "tabula.printSheet",
          "when": "view == tabula.games && (viewItem == game-with-sheet || viewItem == sheet)",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "tabula.printSheet",
          "when": "false"
        },
        {
          "command": "tabula.previewGame",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tabula.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == tabula"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tabula",
          "title": "Tabula",
          "icon": "media/tabula.svg"
        }
      ]
    },
    "views": {
      "tabula": [
        {
          "id": "tabula.games",
          "name": "Games"
        },
        {
          "id": "tabula.wishlist",
          "name": "Wishlist"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tabula.games",
        "contents": "No games found. Open the folder of your vault (the one with vault.yaml), or set tabula.vault."
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "vault.yaml",
          "vault.yml"
        ],
        "url": "./schemas/vault.schema.json"
      },
      {
        "fileMatch": [
          "wishlist.yaml",
          "wishlist.yml"
        ],
        "url": "./schemas/wishlist.schema.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "bundle": "esbuild src/extension.js --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --minify --sourcemap",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.28.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  }
}
