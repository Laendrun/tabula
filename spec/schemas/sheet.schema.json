{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Laendrun/tabula/blob/main/spec/schemas/sheet.schema.json",
  "title": "Tabula score sheet frontmatter",
  "description": "The frontmatter of a .sheet file (SPEC: score sheets).",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Default: the game's title."
    },
    "game": {
      "type": "string",
      "description": "The game it is for (default: the .game file next to it)."
    },
    "size": {
      "type": "string",
      "pattern": "^(?i:a[0-6]|b[45]|letter|legal|tabloid|\\d+(\\.\\d+)?\\s*x\\s*\\d+(\\.\\d+)?(mm)?)$",
      "description": "Paper size: a0 to a6, b4, b5, letter, legal, tabloid, or WIDTHxHEIGHT in mm (210x297). Default: a4."
    },
    "orientation": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape"
      ],
      "description": "Default: portrait."
    },
    "margin": {
      "type": "number",
      "description": "Page margin in mm. Default: 10."
    },
    "font_size": {
      "type": "number",
      "description": "Text size in points."
    },
    "fit": {
      "type": "boolean",
      "description": "Tables fill the page (default true); false keeps rows at their natural height."
    },
    "language": {
      "type": "string",
      "description": "The sheet's language (a code)."
    },
    "symbols": {
      "type": "object",
      "description": "Symbols written :name: in the text: text (an emoji…), an image path, ![sym:TEXT](path), or {image, text}. See SPEC 4.",
      "propertyNames": {
        "pattern": "^[A-Za-z][\\w-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number"
            ]
          },
          {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "description": "An image path (next to vault.yaml, or in the game's folder)."
              },
              "text": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "The text shown where images can't be (the terminal)."
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "values": {
      "type": "object",
      "description": "Values written {=name} in the text: a value, or one per player count ({2p: 7, \"*\": 5}). See SPEC 8.6.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        ]
      }
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "description": "How many rows a {r} row becomes (rounds). Default: 10."
    }
  },
  "additionalProperties": true
}
