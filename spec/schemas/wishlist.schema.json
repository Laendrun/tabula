{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Laendrun/tabula/blob/main/spec/schemas/wishlist.schema.json",
  "title": "Tabula wishlist.yaml",
  "description": "The games and extensions you'd like (SPEC: wishlist).",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "oneOf": [
      {
        "type": "string"
      },
      {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The game or extension you'd like. Required."
          },
          "for": {
            "type": "string",
            "description": "For an extension: the game in the vault it extends (its slug or its title)."
          },
          "in": {
            "type": "string",
            "description": "Also in this pack (the name of another wish): either the pack, or the single ones."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "1 = most wanted."
          },
          "price": {
            "type": [
              "string",
              "number"
            ],
            "description": "35 CHF"
          },
          "link": {
            "type": "string",
            "description": "Where to buy it."
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      }
    ]
  }
}
